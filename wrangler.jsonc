{
  // OGCE Infinity v8.3 on Cloudflare Workers (free tier):
  //  - ./web served as Workers Static Assets
  //  - /health, /api/*, /ws handled by one SQLite-backed Durable Object running the engine (cloudflare/src)
  // Secret (never commit): OGCE_SERVICE_TOKEN, set with `npx wrangler secret put OGCE_SERVICE_TOKEN`.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ogce-infinity",
  "main": "cloudflare/src/index.js",
  "compatibility_date": "2026-11-01",
  "workers_dev": true,
  "routes": [{ "pattern": "ogce.malcolmai.live", "custom_domain": true }],
  "preview_urls": false,
  "assets": {
    "directory": "./web",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "durable_objects": {
    "bindings": [{ "name": "OGCE_WORLD", "class_name": "OGCEWorldV2" }]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["OGCEWorld"] },
    // v2 (12 Nov 2026): owner-approved world reset - engine moved to a fresh class OGCEWorldV2.
    // v3 then deletes the old class, permanently erasing its storage (smoke-test accounts and state).
    { "tag": "v2", "new_sqlite_classes": ["OGCEWorldV2"] },
    { "tag": "v3", "deleted_classes": ["OGCEWorld"] }
  ],
  "observability": { "enabled": true },
  // Non-production preview (v8.3 review): `npx wrangler deploy --env preview`.
  // Separate Worker "ogce-infinity-preview" on workers.dev only (no custom domain/routes), with its own
  // Durable Object and storage, so it never touches production data at ogce.malcolmai.live.
  "env": {
    "preview": {
      "name": "ogce-infinity-preview",
      "workers_dev": true,
      "routes": [],
      "preview_urls": false,
      "durable_objects": {
        "bindings": [{ "name": "OGCE_WORLD", "class_name": "OGCEWorldV2" }]
      },
      "migrations": [{ "tag": "v1", "new_sqlite_classes": ["OGCEWorldV2"] }]
    }
  }
}
