{
  // OGCE engine on Cloudflare Workers (free tier). The v9.0 branch builds "Strata: Lux Genesis"; production (ogce-infinity) stays on v8.3 until the owner approves.
  //  - ./web served as Workers Static Assets
  //  - /health, /api/*, /ws handled by one SQLite-backed Durable Object running the engine (cloudflare/src)
  // Secrets (never commit): OGCE_SERVICE_TOKEN; for live Malcolm also MALCOLM_INFINITY_BOT_TOKEN, plus OGCE_MALCOLM_ENABLED=yes (set per env).
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ogce-infinity",
  "main": "cloudflare/src/index.js",
  "compatibility_date": "2026-11-01",
  "workers_dev": true,
  "routes": [{ "pattern": "ogce.malcolmai.live", "custom_domain": true }],
  "preview_urls": false,
  "assets": {
    "directory": "./web",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "durable_objects": {
    "bindings": [{ "name": "OGCE_WORLD", "class_name": "OGCEWorldV2" }]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["OGCEWorld"] },
    // v2 (12 Nov 2026): owner-approved world reset - engine moved to a fresh class OGCEWorldV2.
    // v3 then deletes the old class, permanently erasing its storage (smoke-test accounts and state).
    { "tag": "v2", "new_sqlite_classes": ["OGCEWorldV2"] },
    { "tag": "v3", "deleted_classes": ["OGCEWorld"] }
  ],
  "observability": { "enabled": true },
  // Non-production preview (v9.0 Strata review): `npx wrangler deploy --env preview`.
  // Separate Worker "ogce-infinity-preview" on workers.dev only (no custom domain/routes), with its own
  // Durable Object and storage, so it never touches production data at ogce.malcolmai.live.
  "env": {
    "preview": {
      "name": "ogce-infinity-preview",
      "workers_dev": true,
      "routes": [],
      "preview_urls": false,
      "durable_objects": {
        "bindings": [{ "name": "OGCE_WORLD", "class_name": "OGCEWorldV2" }]
      },
      "migrations": [{ "tag": "v1", "new_sqlite_classes": ["OGCEWorldV2"] }]
    },
    // Strata production (owner-approved 13 Nov 2026): `npx wrangler deploy --env strata`.
    // NEW Worker "strata-lux-genesis" with its own fresh Durable Object storage, on strata.malcolmai.live and
    // strata.luxthorley.one (the latter goes active once luxthorley.one's nameservers point at Cloudflare).
    // Secrets (never commit): OGCE_SERVICE_TOKEN, MALCOLM_INFINITY_BOT_TOKEN, OGCE_MALCOLM_ENABLED=yes.
    "strata": {
      "name": "strata-lux-genesis",
      "workers_dev": true,
      "routes": [{ "pattern": "strata.malcolmai.live", "custom_domain": true }],
      "preview_urls": false,
      "durable_objects": {
        "bindings": [{ "name": "OGCE_WORLD", "class_name": "OGCEWorldV2" }]
      },
      "migrations": [{ "tag": "v1", "new_sqlite_classes": ["OGCEWorldV2"] }]
    }
  }
}
