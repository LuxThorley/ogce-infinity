{
  "name": "ogce-infinity",
  "version": "8.2.0",
  "private": true,
  "type": "module",
  "description": "OGCE Infinity v8.2 browser game on Cloudflare Workers (static assets + Durable Object engine)",
  "scripts": {
    "test": "node --test cloudflare/test/*.test.mjs",
    "test:python": "python -m pytest -q",
    "fixtures": "python cloudflare/tools/gen_fixtures.py",
    "dev": "wrangler dev",
    "check": "wrangler deploy --dry-run --outdir .wrangler/dry-run",
    "deploy": "wrangler deploy"
  },
  "devDependencies": {
    "wrangler": "^4.0.0"
  }
}
